# Offline rebuild of the admin UI: reuse the dependency image shipped in a transfer bundle
# (cortex-frontend-deps:<version> = node_modules from `npm ci`, produced by `make build-deps`)
# and build the current source without touching the network:
#   make build-offline            (docker build --network none -f Dockerfile.offline ...)
ARG DEPS_IMAGE=cortex-frontend-deps:dev
ARG NODE_IMAGE=node:22-alpine

# dev target: hot-reload server for docker.compose.dev.yaml (source is bind-mounted over /app)
FROM ${DEPS_IMAGE} AS dev
WORKDIR /app
COPY . .
EXPOSE 3001
CMD ["npm", "run", "dev"]

FROM ${DEPS_IMAGE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npm run build

FROM ${NODE_IMAGE} AS prod
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3001 HOSTNAME=0.0.0.0
# `output: 'standalone'` emits a minimal server with only the modules it needs
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -qO- http://127.0.0.1:3001/runtime-config.js >/dev/null 2>&1 || exit 1
CMD ["node", "server.js"]
