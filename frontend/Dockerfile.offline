# Offline rebuild of the admin UI: reuse the dependency image shipped in a transfer bundle
# (cortex-frontend-deps:<version> = node_modules from `npm ci`, produced by `make build-deps`)
# and build the current source without touching the network:
#   make build-offline            (docker build --network none -f Dockerfile.offline ...)
ARG DEPS_IMAGE=cortex-frontend-deps:dev
ARG NODE_IMAGE=node:22-alpine

FROM ${DEPS_IMAGE} AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN npm run build && npm prune --omit=dev

FROM ${NODE_IMAGE} AS prod
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/.next ./.next
COPY --from=build --chown=node:node /app/next.config.mjs ./
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -qO- http://127.0.0.1:3001/login >/dev/null 2>&1 || exit 1
CMD ["npm", "run", "start"]
