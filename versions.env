# Cortex pinned image versions - single source of truth.
#
# Consumed by:
#   - Makefile            (`include versions.env` + export, so `make up` passes them to compose)
#   - docker.compose.*.yaml (`${VAR:-default}`; the defaults there MUST equal the values here)
#   - scripts/prepare-offline-deployment.sh, load-offline-deployment.sh, verify-offline-images.sh
#   - .github/workflows/ci.yml
#
# backend/src/config.py carries the SAME engine defaults (VLLM_IMAGE, LLAMACPP_IMAGE) so a
# gateway started without these env vars still uses the pinned images. Keep both in sync;
# `make versions` prints every source side by side.
#
# Format: plain KEY=value, no quotes, no shell expansion (the file is both `source`d by bash
# and `include`d by make). Override per invocation with `make up VLLM_IMAGE=...` or by
# editing this file, then `make prepare-offline` to refresh the air-gap package.

# ---------------------------------------------------------------------------
# Inference engines
# ---------------------------------------------------------------------------
# vLLM v0.28.0 is built on CUDA 13 and needs NVIDIA driver >= 580 on the host.
# For drivers 550-579 use the CUDA 12.9 build: vllm/vllm-openai:v0.28.0-cu129
# (see docs/models/nemotron-3-super.md for the driver -> image table).
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
# llama.cpp build b10731, CUDA 12.8 runtime. `server-cuda` without a build number floats daily.
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10731

# ---------------------------------------------------------------------------
# Cortex images (built locally by `make build`; tagged with CORTEX_VERSION)
# ---------------------------------------------------------------------------
CORTEX_VERSION=0.2.0
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:22-alpine

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16
REDIS_IMAGE=redis:7
PGADMIN_IMAGE=dpage/pgadmin4:8.7

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter:3.3.9-3.6.1-ubuntu22.04
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.49.2
