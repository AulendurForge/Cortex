# Cortex root .env - read by `make` and `docker compose` (both compose files).
# Copy to .env and edit. Image tags live in versions.env, not here.
# Every value below shows its default; leave a line out to keep the default.

# ---------------------------------------------------------------------------
# Host paths mounted into the gateway and model containers
# (the gateway runs as uid 1000: sudo chown -R 1000:1000 /var/cortex)
# ---------------------------------------------------------------------------
CORTEX_MODELS_DIR=/var/cortex/models
HF_CACHE_DIR=/var/cortex/hf-cache
CORTEX_EXPORT_DIR=/var/cortex/exports

# ---------------------------------------------------------------------------
# Ports (host side)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3001
# Prometheus (host). Default 19090 avoids Cockpit and other tools on 9090.
PROM_PORT=19090
PROM_RETENTION=7d
# Loopback-only infra ports (non-standard to avoid clashes with host services)
CORTEX_POSTGRES_PORT=15432
CORTEX_REDIS_PORT=16379
NODE_EXPORTER_PORT=9100
DCGM_PORT=9400
CADVISOR_PORT=8085
PGADMIN_PORT=5050

# ---------------------------------------------------------------------------
# Network / CORS
# ---------------------------------------------------------------------------
# LAN IP shown in URLs and added to CORS. Detected by scripts/detect-ip.sh when unset.
#HOST_IP=192.168.1.50
# Production: the exact UI origin(s) served by your TLS proxy (required by the prod compose)
#CORS_ALLOW_ORIGINS=https://cortex.example.com
# Gateway address the browser should call. Empty = http://<this host>:8084 (LAN/dev);
# "/" = same origin, for the reverse-proxy layout in docs/operations/production-deployment.md
#CORTEX_GATEWAY_URL=/

# ---------------------------------------------------------------------------
# Secrets: `make up` generates the two below when blank (openssl rand -hex 32)
# ---------------------------------------------------------------------------
INTERNAL_VLLM_API_KEY=
SESSION_SECRET=
SESSION_TTL_HOURS=8
# true behind TLS (prod default true, dev false)
#SESSION_COOKIE_SECURE=true
# Admin account. `make up` asks for these once while they are blank; `make setup-admin` changes
# them later (and updates the running gateway). Used to create the first admin on an empty database.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ORG=Default
# Prod database credentials (Postgres is loopback-only)
#POSTGRES_USER=cortex
#POSTGRES_PASSWORD=cortex
#POSTGRES_DB=cortex

# ---------------------------------------------------------------------------
# Engines and offline operation
# ---------------------------------------------------------------------------
# Defaults come from versions.env. Override e.g. for drivers < 580:
#VLLM_IMAGE=vllm/vllm-openai:v0.28.0-cu129
#LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10731
# Air-gapped hosts: never pull images
OFFLINE_MODE=false
#REQUIRE_IMAGE_PRECACHE=false

# ---------------------------------------------------------------------------
# Lifecycle and limits
# ---------------------------------------------------------------------------
STOP_MODELS_ON_SHUTDOWN=false
MODEL_RECONCILE_SEC=15
REQUEST_MAX_BODY_BYTES=8388608
# Prod compose enables these; dev leaves them off
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_RPS=10
#RATE_LIMIT_BURST=20
#CONCURRENCY_LIMIT_ENABLED=true
#MAX_CONCURRENT_STREAMS_PER_ID=5

# ---------------------------------------------------------------------------
# Optional static upstream pools (engines you run yourself; managed models register themselves)
# ---------------------------------------------------------------------------
#VLLM_GEN_URLS=
#VLLM_EMB_URLS=

# ---------------------------------------------------------------------------
# Compose knobs
# ---------------------------------------------------------------------------
# Profiles: linux (node-exporter, cadvisor), gpu (dcgm), tools (pgadmin, dev only). `make` auto-detects.
#COMPOSE_PROFILES=linux,gpu
# Debug only: keep the gateway running as root instead of dropping to uid 1000
#CORTEX_RUN_AS_ROOT=false
# Prod resource limits
#GATEWAY_MEM_LIMIT=4g
#FRONTEND_MEM_LIMIT=1g
#POSTGRES_MEM_LIMIT=2g
#REDIS_MEM_LIMIT=768m
#PROM_MEM_LIMIT=2g
# Prod: bind the UI on the LAN instead of loopback (only without a proxy; not recommended)
#FRONTEND_BIND=127.0.0.1
