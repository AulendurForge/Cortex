# Cortex gateway settings (backend/src/config.py) with their defaults.
#
# This file is read ONLY when the gateway runs outside Docker (`uvicorn` from backend/).
# Under docker compose the values come from the compose file and the root .env; the
# container never sees backend/.env. Copy to backend/.env and edit for local development.

# --- Auth ---
INTERNAL_VLLM_API_KEY=            # shared secret passed as --api-key to every model container
GATEWAY_DEV_ALLOW_ALL_KEYS=false  # true = accept any bearer token on /v1 (dev only)
SESSION_SECRET=                   # HMAC key for admin session cookies; auto-generated + stored in config_kv when empty
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false       # true behind TLS
ADMIN_BOOTSTRAP_USERNAME=         # create the first admin at startup while none exists
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ORG=

# --- HTTP ---
REQUEST_MAX_BODY_BYTES=1048576
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
SECURITY_HEADERS_ENABLED=true

# --- Data stores (local dev: Postgres/Redis on their default ports) ---
DATABASE_URL=postgresql+asyncpg://cortex:cortex@localhost:5432/cortex
REDIS_URL=redis://localhost:6379/0
PROMETHEUS_URL=http://localhost:19090

# --- Rate limiting / concurrency / circuit breaker ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_WINDOW_SEC=0
RATE_LIMIT_MAX_REQUESTS=0
CONCURRENCY_LIMIT_ENABLED=false
MAX_CONCURRENT_STREAMS_PER_ID=5
CB_ENABLED=false
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_SEC=30
CB_TIMEOUT_THRESHOLD=3
CB_TIMEOUT_COOLDOWN=60
CB_HEALTH_CHECK_INTERVAL=10

# --- Upstream health ---
HEALTH_CHECK_TTL_SEC=30
HEALTH_CHECK_PATH=/health
HEALTH_POLL_SEC=10
TOKEN_ESTIMATION_ENABLED=true

# --- Optional static upstream pools (managed models register themselves) ---
VLLM_GEN_URLS=http://localhost:8001
VLLM_EMB_URLS=http://localhost:8002
LLAMACPP_GEN_URLS=

# --- Observability ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cortex-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Storage (container-visible paths; *_HOST are what model containers bind-mount) ---
CORTEX_MODELS_DIR=/var/cortex/models
HF_CACHE_DIR=/var/cortex/hf-cache
CORTEX_EXPORT_DIR=/var/cortex/exports
CORTEX_MODELS_DIR_HOST=           # defaults to CORTEX_MODELS_DIR
HF_CACHE_DIR_HOST=                # defaults to HF_CACHE_DIR

# --- Engine images (keep identical to versions.env) ---
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b10731

# --- Offline / air-gapped ---
OFFLINE_MODE=false
OFFLINE_MODE_AUTO_DETECT=true
REQUIRE_IMAGE_PRECACHE=false
IMAGE_PULL_TIMEOUT=600

# --- Engine startup / serving ---
VLLM_STARTUP_TIMEOUT=600
LLAMACPP_STARTUP_TIMEOUT=300
LLAMACPP_SERVER_TIMEOUT=300
LLAMACPP_METRICS_ENABLED=true
LLAMACPP_SLOTS_ENABLED=true
LLAMACPP_LOG_TIMESTAMPS=true

# --- Lifecycle ---
STOP_MODELS_ON_SHUTDOWN=false
MODEL_RECONCILE_SEC=15
